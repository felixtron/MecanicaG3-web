{
  "name": "g3web",
  "version": "1.0.0",
  "description": "Escuela de Mecánica Automotriz G3 - Website",
  "engines": {
    "node": ">=20.11.0",
    "npm": ">=10"
  },
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "lint": "node scripts/lint.js",
    "check:lockfile": "node scripts/check-lockfile.js",
    "smoke": "node scripts/smoke.js",
    "check": "npm run lint && npm run check:lockfile && npm run smoke",
    "hooks:install": "git config core.hooksPath .githooks",
    "prepare": "git config core.hooksPath .githooks || exit 0"
  },
  "dependencies": {
    "axios": "^1.14.2",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "ejs": "^3.1.10",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.0",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0",
    "nodemailer": "^6.9.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
