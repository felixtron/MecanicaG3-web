        <script>
        (function() {
          var row = document.querySelector('.meet-ask-row');
          if (!row) return;
          function update() {
            var rect = row.getBoundingClientRect();
            var wh = window.innerHeight;
            var progress = (wh - rect.top) / wh;
            var tx = -600 + (progress * 400);
            row.style.setProperty('--meet-tx', tx + 'px');
          }
          window.addEventListener('scroll', update, { passive: true });
          update();
        })();
        </script>
