<%- include('partials/head', { title, description, extraCss }) %>
    <!-- Content -->
    <div class="page-wraper">
    <div class="blog-page-content style-1 sticky-header">
        <!-- Coming Soon -->
        <div class="dlab-coming-soon bg-img-fix dlab-coming-soon-full overlay-black-middle" style="background-image:url(/images/background/bg1.jpg);">
            <div class="container">
				<div class="dlab-coming-bx">
					<div class="top-head text-center logo-header">
						<a href="/">
							<img src="/images/logo.png" alt="Escuela de Mecánica Automotriz G3"/>
						</a>
					</div>
					<div class="coming-soon-content text-center text-white m-b30">
						<h2>Estamos trabajando para ti</h2>
						<p>Esta sección estará disponible próximamente.</p>
					</div>
					<div class="countdown text-center">
						<div class="date"><span class="time days text-primary"></span>
							<span>Días</span>
						</div>
						<div class="date"><span class="time hours text-primary"></span>
							<span>Horas</span>
						</div>
						<div class="date"><span class="time mins text-primary"></span>
							<span>Minutos</span>
						</div>
						<div class="date"><span class="time secs text-primary"></span>
							<span>Segundos</span>
						</div>
					</div>
					<div class="text-center m-t50 info-style-1">
						<a href="/" class="site-button radius-xl outline m-lr5">Regresar al Inicio</a>
						<a data-toggle="modal" href="#myModal" data-target="#myModal" class="site-button radius-xl outline m-lr5">Mantente Informado</a>
					</div>
					<div class="social-icon">
						<ul class="dlab-social-icon">
							<li><a class="fa fa-facebook" href="https://www.facebook.com/escuelamecanicag3" target="_blank"></a></li>
							<li><a class="fa fa-instagram" href="https://www.instagram.com/mecanica.g3/" target="_blank"></a></li>
							<li><a class="fa fa-linkedin" href="https://www.linkedin.com/company/mec%C3%A1nica-g3" target="_blank"></a></li>
							<li><a class="fa fa-youtube-play" href="https://www.youtube.com/channel/UCDna_ii2XAqfegq8AP1wz4g" target="_blank"></a></li>
						</ul>
					</div>
				</div>
			</div>
        </div>
        <!-- Coming Soon End -->
    </div>
    <!-- Content END-->
    </div>
<!-- Modal -->
<div class="modal fade contact-form" id="myModal" tabindex="-1" role="dialog" aria-hidden="true">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-body">
				<form class="p-b20" method="post" action="/api/subscribe">
					<div class="row">
						<button name="reset" type="reset" value="Reset" data-dismiss="modal" class="close-btn">&times;</button>
						<div class="col-lg-12 text-center text-white">
							<h2 class="text-white">Registra tu correo</h2>
							<p>Déjanos tu email y te avisaremos cuando esta sección esté lista.</p>
						</div>
						<div class="col-lg-12">
							<div class="m-b15">
								<input placeholder="Tu correo electrónico" name="dzEmail" type="email" required class="form-control radius-xl">
							</div>
						</div>
						<div class="col-lg-12">
							<button name="submit" type="submit" value="Submit" class="site-button radius-xl outline btn-block">Enviar</button>
						</div>
					</div>
				</form>
			</div>
		</div>
	</div>
</div>
<%- include('partials/scripts', { extraJs: typeof extraJs !== 'undefined' ? extraJs : [], inlineJs: typeof inlineJs !== 'undefined' ? inlineJs : '', useRecaptcha: typeof useRecaptcha !== 'undefined' ? useRecaptcha : false }) %>
