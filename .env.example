# Server
PORT=3000
NODE_ENV=development

# Correo — Google Workspace vía contraseña de aplicación.
#
# SMTP_USER es la cuenta que AUTENTICA y aparece como remitente. Tiene que ser
# un buzón real o un alias suyo: Gmail reescribe cualquier otro remitente.
# SMTP_PASS es una contraseña de aplicación (16 caracteres), NO la del correo;
# requiere verificación en 2 pasos activada en esa cuenta.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=felix.garduno@mecanicag3.com
SMTP_PASS=
EMAIL_FROM_NAME=Formulario WEB

# Destinatario. Puede ser un Grupo de Google (info@) para que lo reciba toda la
# oficina: un grupo sirve como destinatario aunque no pueda ser remitente.
EMAIL_TO=info@mecanicag3.com

# Respaldo en disco de cada contacto (JSONL). Se escribe SIEMPRE, incluso si el
# correo falla, para no volver a perder prospectos. En el contenedor es un
# volumen; en local puedes usar ./contactos.jsonl
LEADS_FILE=/data/contactos.jsonl

# reCAPTCHA v2 (opcional). Sin RECAPTCHA_SITE_KEY el formulario funciona sin captcha.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET=

# MailChimp (boletín)
MAILCHIMP_API_KEY=
MAILCHIMP_LIST_ID=
